  <UserdefinedSymbols/>
  <LuaScript>-- Auto-attach ke ninja_saga.exe saat Cheat Table dibuka
local function autoAttachNinjaSaga()
  local pid = getProcessIDFromProcessName("ninja_saga.exe")
  if pid and pid &gt; 0 and getOpenedProcessID() ~= pid then
    openProcess(pid)
  end
end
autoAttachNinjaSaga()
</LuaScript>
