<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>99</ID>
      <Description>"★ [KLIK DULU JIKA P-&gt;????????] Auto-Connect ke ninja_saga.exe"</Description>
      <Color>00FFFF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local pid = getProcessIDFromProcessName("ninja_saga.exe")
if pid and pid &gt; 0 then
  openProcess(pid)
  print("Berhasil terhubung ke ninja_saga.exe (PID: " .. tostring(pid) .. ")")
else
  showMessage("Game ninja_saga.exe belum jalan! Silakan buka game Ninja Saga terlebih dahulu.")
end
{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>1</ID>
      <Description>"★ 100% Dodge Khusus Player + Anti Dodge Musuh (PvE &amp; Minotaur - Anti Freeze)"</Description>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// =========================================================================
// SMART DODGE PLAYER ONLY + ANTI DODGE MUSUH (BattleProcessor.checkDodge)
// Dipatch tepat di baris paling awal fungsi checkDodge():
// 1. _loc15_.dodge = (this.defender.side == 1)
// 2. this.attacker.setBattleAction(_loc15_)
// 3. returnvoid
// - Saat Player diserang (defender.side == 1) -> Dodge = TRUE (100% Dodge!)
// - Saat Musuh/Minotaur diserang (defender.side == 2) -> Dodge = FALSE (Pasti Kena!)
// =========================================================================
aobscan(smartDodgeStartAOB,62 0F 27 61 BF 4B D0 66 A4 09 62 0F 4F 86 4B 01 D0 66 A4 09 66 C0 4B D0 66 A5 09 66 C0 4B 14 01 00 00 47)
registersymbol(smartDodgeStartAOB)

smartDodgeStartAOB:
  db 62 0F D0 66 A5 09 66 C0 4B 24 01 AB 61 BF 4B D0 66 A4 09 62 0F 4F 86 4B 01 47 02 02 02 02 02 02 02 02 02

[DISABLE]
smartDodgeStartAOB:
  db 62 0F 27 61 BF 4B D0 66 A4 09 62 0F 4F 86 4B 01 D0 66 A4 09 66 C0 4B D0 66 A5 09 66 C0 4B 14 01 00 00 47
unregistersymbol(smartDodgeStartAOB)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>30</ID>
      <Description>"★ Darah Kebal Sejati (Player &amp; Pet Kebal HP - SafeGodHp Anti Freeze)"</Description>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// =========================================================================
// DARAH KEBAL SEJATI (100% AMAN - TANPA UBAH POINTER RAM / TANPA ERROR SHA1)
// - Mem-patch BattleProcessor.updateHP &amp; Battle.processDamage:
//   Jika target adalah Player/Pet/Recruit (side == 1) dan menerima damage (param2 &lt; 0),
//   damage langsung diubah menjadi 0 sebelum memanggil updateHP!
// - Karena melalui fungsi resmi updateHP(), hash SHA1 (hpHashString) selalu sinkron
//   dan TIDAK AKAN memicu "Sorry, you have lost connection to the server" (Main.onError).
// - Bisa dicentang di halaman Login maupun setelah masuk Desa (sebelum masuk Battle).
// =========================================================================
aobscan(safeGodHpAOB,D1 60 F8 0B 66 F4 31 46 E3 4A 01 12 03 00 00 24 00 D6)
registersymbol(safeGodHpAOB)

safeGodHpAOB:
  db D1 66 C0 4B 24 01 AB 02 02 02 02

[DISABLE]
safeGodHpAOB:
  db D1 60 F8 0B 66 F4 31 46 E3 4A 01
unregistersymbol(safeGodHpAOB)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>31</ID>
      <Description>"★ Chakra / CP Kebal (0 CP Cost Jutsu &amp; Bloodline + Anti Error / Anti Disconnect)"</Description>
      <Color>00FF00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// =========================================================================
// CHAKRA / CP KEBAL (100% AMAN - TANPA UBAH POINTER RAM / TANPA ERROR SHA1)
// 1. BattleProcessor.updateCP: Jika Player/Pet/Recruit (side == 1) mengalami
//    pengurangan CP (param2 &lt; 0), otomatis diubah menjadi 0!
// 2. Character.setCommand: Mengubah syarat CP semua Jutsu &amp; Bloodline menjadi 0 CP.
// 3. Battle.playAction: Mengubah pemotongan CP di mode Network/Minotaur PvE menjadi 0.
// - Dijamin tidak memicu "Sorry, you have lost connection to the server" (Main.onError).
// - Bisa dicentang di halaman Login maupun setelah masuk Desa (sebelum masuk Battle).
// =========================================================================
aobscan(battleInfCpAOB,5D 05 D1 60 9A 08 66 D1 29 46 E3 4A 01 46 05 01 76 2A 12 05 00 00 29 D2 24 00 AD 12 03 00 00 24 00 D6)
registersymbol(battleInfCpAOB)

