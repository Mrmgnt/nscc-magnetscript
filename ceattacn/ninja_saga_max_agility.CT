<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>15</ID>
      <Description>"★ 100% Dodge Khusus Player (POINTER PLAYER ONLY - Musuh Tidak Dodge)"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

-- Pointer khusus karakter player (Adobe AIR.dll + 0xE29C18 -&gt; 0x508 -&gt; 0x8 -&gt; 0x4C -&gt; 0x510 -&gt; 0x1D0 -&gt; 0x4).
-- Offset Agility player: 0xEF4 (nilai normal 700 - 1500).
-- Mengunci Agility player ke 999999: Player 100% selalu dodge &amp; kecepatan aksi melompat maksimal,
-- sedangkan MUSUH TIDAK TERPENGARUH SAMA SEKALI (musuh tidak ikut dodge).
local chain = {0x508, 0x8, 0x4C, 0x510, 0x1D0, 0x4}
local FINAL = 0xEF4

local function valid(p)
  return p ~= nil and p &gt; 0x10000 and p &lt; 0x7FFF0000
end

local function resolve()
  local base = getAddress("Adobe AIR.dll")
  if not valid(base) then return nil end
  local p = readPointer(base + 0xE29C18)
  for i = 1, #chain do
    if not valid(p) then return nil end
    p = readPointer(p + chain[i])
  end
  if not valid(p) then return nil end
  return p + FINAL
end

local a0 = resolve()
if a0 == nil then showMessage("Chain pointer belum valid. Aktifkan saat karakter sudah masuk di battle.") return end
origAgility = readInteger(a0)
if origAgility == nil or origAgility &lt;= 0 then origAgility = 720 end

-- Langsung tulis Agility saat enable
writeInteger(a0, 999999)

if agilityTimer ~= nil then agilityTimer.destroy() end
agilityTimer = createTimer(nil)
agilityTimer.Interval = 100
agilityTimer.OnTimer = function(t)
  local a = resolve()
  if a == nil then return end
  local cur = readInteger(a)
  if cur ~= nil and cur &lt; 999999 then
    writeInteger(a, 999999)
  end
end

[DISABLE]
{$lua}
if syntaxcheck then return end
if agilityTimer ~= nil then agilityTimer.destroy() agilityTimer = nil end
local a = resolve()
if a ~= nil and origAgility ~= nil then
  writeInteger(a, origAgility)
end
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>10</ID>
      <Description>"★ Always Hit / Anti Dodge Musuh (Minotaur 100% Kena Serang)"</Description>
      <Color>008800</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// BattleProcessor.checkDodge:
// Memaksa kedua branch dodge musuh menjadi pushfalse (27).
// Minotaur (Head, Left Arm, Right Arm) tidak bisa dodge sama sekali!
// Serangan player 100% DIJAMIN SELALU KENA.
aobscan(dodgeAOB, 13 06 00 00 62 0F ?? 61 BF 4B 10 11 00 00 60 FB 07 D0 2C A0 58 4F F6 13 02 62 0F ?? 61 BF 4B)
registersymbol(dodgeAOB)

dodgeAOB+6:
  db 27

dodgeAOB+1B:
  db 27

[DISABLE]
dodgeAOB+6:
  db 26

dodgeAOB+1B:
  db 27

unregistersymbol(dodgeAOB)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>9</ID>
      <Description>"★ Darah Kebal Sejati (True God Mode - Auto Heal HP +0xEE0)"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

-- PERBAIKAN BUG OFFSET:
-- +0xED8 = Max HP
-- +0xEE0 = CURRENT HP LIVE (Darah yang berkurang saat kena hit)
-- Script ini membaca Max HP dari +0xED8 dan seketika mengisi ulang Current HP (+0xEE0).
local chain = {0x508, 0x8, 0x4C, 0x510, 0x1D0, 0x4}
local FINAL_CUR_HP = 0xEE0
local FINAL_MAX_HP = 0xED8

local function valid(p)
  return p ~= nil and p &gt; 0x10000 and p &lt; 0x7FFF0000
end

local function resolve(offset)
  local base = getAddress("Adobe AIR.dll")
  if not valid(base) then return nil end
  local p = readPointer(base + 0xE29C18)
  for i = 1, #chain do
    if not valid(p) then return nil end
    p = readPointer(p + chain[i])
  end
  if not valid(p) then return nil end
  return p + offset
end

local aHp = resolve(FINAL_CUR_HP)
local aMax = resolve(FINAL_MAX_HP)
if aHp == nil or aMax == nil then showMessage("Chain pointer belum valid. Aktifkan saat sudah di dalam battle.") return end

cachedMaxHp = readInteger(aMax)
if cachedMaxHp == nil or cachedMaxHp &lt;= 0 then cachedMaxHp = 4060 end

-- Langsung pulihkan ke max jika sedang sekarat
local cNow = readInteger(aHp)
if cNow ~= nil and cNow &lt; cachedMaxHp then
  writeInteger(aHp, cachedMaxHp)
end

if hpTimer ~= nil then hpTimer.destroy() end
hpTimer = createTimer(nil)
hpTimer.Interval = 100
hpTimer.OnTimer = function(t)
  local curAddr = resolve(FINAL_CUR_HP)
  local maxAddr = resolve(FINAL_MAX_HP)
  if curAddr == nil or maxAddr == nil then return end

  local maxVal = readInteger(maxAddr)
  if maxVal == nil or maxVal &lt;= 0 then maxVal = cachedMaxHp end

  local curVal = readInteger(curAddr)
  if curVal ~= nil and curVal &lt; maxVal then
    writeInteger(curAddr, maxVal)
  end
end

[DISABLE]
{$lua}
if syntaxcheck then return end
if hpTimer ~= nil then hpTimer.destroy() hpTimer = nil end
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>14</ID>
      <Description>"Chakra / CP Kebal (Auto Restore CP +0xEFC)"</Description>
      <Color>00AA00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

local chain = {0x508, 0x8, 0x4C, 0x510, 0x1D0, 0x4}
local FINAL_CP = 0xEFC
local FINAL_CPMAX = 0xEF8

local function valid(p)
  return p ~= nil and p &gt; 0x10000 and p &lt; 0x7FFF0000
end

local function resolve(offset)
  local base = getAddress("Adobe AIR.dll")
  if not valid(base) then return nil end
  local p = readPointer(base + 0xE29C18)
  for i = 1, #chain do
    if not valid(p) then return nil end
    p = readPointer(p + chain[i])
  end
  if not valid(p) then return nil end
  return p + offset
end

local a0 = resolve(FINAL_CP)
if a0 == nil then showMessage("Chain belum valid. Aktifkan saat sudah di dalam battle.") return end

if cpTimer ~= nil then cpTimer.destroy() end
cpTimer = createTimer(nil)
cpTimer.Interval = 100
cpTimer.OnTimer = function(t)
  local aCp = resolve(FINAL_CP)
  local aMax = resolve(FINAL_CPMAX)
  if aCp == nil or aMax == nil then return end
  local maxCp = readInteger(aMax) or 1000
  local curCp = readInteger(aCp)
  if curCp ~= nil and curCp &lt; maxCp then
    writeInteger(aCp, maxCp)
  end
end

[DISABLE]
{$lua}
if syntaxcheck then return end
if cpTimer ~= nil then cpTimer.destroy() cpTimer = nil end
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>11</ID>
      <Description>"Anti Cooldown / No Cooldown (All Skills Instant)"</Description>
      <Color>00AA00</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// 1) CharacterBase.isBattleSkillCooldown:
// Memaksa fungsi cek cooldown selalu return false (27 = pushfalse alih-alih 26 = pushtrue).
// Berlaku untuk semua skill reguler, Bloodline, dan Senjutsu.
aobscan(noCdCheckAOB, D6 D2 D1 46 F1 34 01 24 00 0F 02 00 00 26 48 27 48)
registersymbol(noCdCheckAOB)

noCdCheckAOB+D:
  db 27

// 2) CharacterBase.setSkillCooldown:
// Mencegah game mencatat cooldown ke tabel saat skill dipakai (returnvoid = 47).
aobscan(noCdSetAOB, D0 30 24 00 D6 24 00 D7 20 85 63 04 5D 02 D1 66 A3 54 46 02)
registersymbol(noCdSetAOB)

noCdSetAOB:
  db 47

[DISABLE]
noCdCheckAOB+D:
  db 26

noCdSetAOB:
  db D0

unregistersymbol(noCdCheckAOB)
unregistersymbol(noCdSetAOB)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>12</ID>
      <Description>"Auto Massive Damage / 1-Hit Kill (A3 -&gt; A9)"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// 1) BattleProcessor.calcSkillDamage:
// Mengubah operasi bagi (A3 = divide) menjadi bitwise OR (A9 = bitor).
// Menghasilkan damage jutaan (sekali serang Minotaur langsung tewas).
aobscan(dmgBP, 46 D7 4A 01 46 01 01 24 04 A2 25 E8 07 A3 A2 46)
registersymbol(dmgBP)

dmgBP+D:
  db A9

// 2) Main.calcSkillDamage:
aobscan(dmgMain, 46 BC 35 01 46 01 01 24 04 A2 25 E8 07 A3 A2 46)
registersymbol(dmgMain)

dmgMain+D:
  db A9

[DISABLE]
dmgBP+D:
  db A3

dmgMain+D:
  db A3

unregistersymbol(dmgBP)
unregistersymbol(dmgMain)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>13</ID>
      <Description>"[JANGAN DIPAKAI] Always Dodge Global (PERINGATAN: Musuh Ikut Dodge)"</Description>
      <Color>808080</Color>
      <VariableType>Auto Assembler Script</VariableType>
