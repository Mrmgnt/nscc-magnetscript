    <CheatEntry>
      <ID>3</ID>
      <Description>"★ Auto Massive Damage / 1-Hit Kill Khusus Musuh (Seal Enemy - Anti Freeze)"</Description>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
// =========================================================================
// 1-HIT KILL KHUSUS MUSUH &amp; BOSS/MINOTAUR (BattleProcessor.processDamage)
// - Memanfaatkan mekanisme resmi seal_enemy di BattleProcessor.processDamage:
//   if (this.defender.side == 2) { _loc7_ = -this.defender.maxHP; }
// - Musuh / Minotaur langsung mati dalam 1 serangan apa saja (Attack / Jutsu)!
// - Player (side == 1) menerima damage normal (atau 0 jika Darah Kebal aktif).
// - 100% Anti-Freeze: hanya mem-patch 9 byte condition tanpa merusak stack / jump offset!
// =========================================================================
aobscan(oneHitSealEnemyAOB,60 DE 07 66 B6 1F 66 91 4C 12 0B 00 00 D0 66 A5 09 66 F6 4A 90 73 63 07)
registersymbol(oneHitSealEnemyAOB)

oneHitSealEnemyAOB:
  db D1 66 C0 4B 24 02 AB 02 02

[DISABLE]
oneHitSealEnemyAOB:
  db 60 DE 07 66 B6 1F 66 91 4C
unregistersymbol(oneHitSealEnemyAOB)
</AssemblerScript>
